{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://bvf.local/schemas/attempt_state.schema.json","title":"BVF Attempt State (Mutable)","type":"object","required":["task_id","authorization_id","authorization_sha256","attempt_id","claim_sha256","status","status_changed_at","process_id"],"properties":{"task_id":{"type":"string","minLength":1},"authorization_id":{"type":"string","minLength":1},"authorization_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"attempt_id":{"type":"string","minLength":1},"claim_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["CLAIMED","EXECUTING","EXECUTED","FINALIZED","INDETERMINATE"]},"status_changed_at":{"type":"string"},"process_id":{"type":"integer"}},"additionalProperties":false}